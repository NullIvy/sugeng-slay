{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "kitty-direct", "source": "__HOME__/.config/fastfetch/logo-cyber.png", "width": 60, "height": 30,
            "padding": { "top": 3, "left": 2, "right": 3 } },
  "display": {
    "separator": " ",
    "bar": { "char": { "elapsed": "━", "total": "─" }, "border": { "left": "", "right": "" },
             "color": { "total": "38;2;60;52;100" }, "width": 14 },
    "percent": { "type": ["num", "bar"], "green": 60, "yellow": 85,
      "color": { "green": "38;2;94;234;242", "yellow": "38;2;242;196;109", "red": "38;2;255;77;109" } }
  },
  "modules": [
    { "type": "title", "format": "   \u001b[38;2;214;211;245mHello \u001b[1;38;2;94;234;242m{user-name}\u001b[22;38;2;214;211;245m, I'm \u001b[1;38;2;169;156;255m{host-name}\u001b[0m" },
    { "type": "command", "key": " ", "text": "zsh __HOME__/.config/fastfetch/greet.sh", "format": "   \u001b[3;38;2;130;120;190m{1}\u001b[0m" },
    "break",

    { "type": "custom", "format": "\u001b[38;2;169;156;255m\u001b7╭────────────────────────────────────────────────────────────╮\u001b8\u001b[21C ◆◆◆ \u001b[1m  SYSTEM  \u001b[22m ◆◆◆ \u001b[0m" },
    { "type": "os",      "key": "\u001b7\u001b[61C\u001b[38;2;169;156;255m│\u001b8\u001b[38;2;169;156;255m│  \uf179  \u001b[1;38;2;233;230;255mDistro    \u001b[0m", "format": "{name} {version}" },
    { "type": "os",      "key": "\u001b7\u001b[61C\u001b[38;2;169;156;255m│\u001b8\u001b[38;2;169;156;255m│  \uf02a  \u001b[1;38;2;233;230;255mBuild     \u001b[0m", "format": "{build-id}" },
    { "type": "kernel",  "key": "\u001b7\u001b[61C\u001b[38;2;169;156;255m│\u001b8\u001b[38;2;169;156;255m│  \uf013  \u001b[1;38;2;233;230;255mKernel    \u001b[0m" },
    { "type": "uptime",  "key": "\u001b7\u001b[61C\u001b[38;2;169;156;255m│\u001b8\u001b[38;2;169;156;255m│  \uf017  \u001b[1;38;2;233;230;255mUptime    \u001b[0m" },
    { "type": "command", "key": "\u001b7\u001b[61C\u001b[38;2;169;156;255m│\u001b8\u001b[38;2;169;156;255m│  \uf01e  \u001b[1;38;2;233;230;255mUpdate    \u001b[0m", "text": "zsh __HOME__/.config/fastfetch/stat.sh update" },
    { "type": "custom", "format": "\u001b[38;2;169;156;255m╰────────────────────────────────────────────────────────────╯\u001b[0m" },

    { "type": "custom", "format": "\u001b[38;2;94;234;242m\u001b7╭────────────────────────────────────────────────────────────╮\u001b8\u001b[21C ◆◆◆ \u001b[1m SOFTWARE \u001b[22m ◆◆◆ \u001b[0m" },
    { "type": "packages", "key": "\u001b7\u001b[61C\u001b[38;2;94;234;242m│\u001b8\u001b[38;2;94;234;242m│  \uf487  \u001b[1;38;2;233;230;255mPackages  \u001b[0m" },
    { "type": "shell",    "key": "\u001b7\u001b[61C\u001b[38;2;94;234;242m│\u001b8\u001b[38;2;94;234;242m│  \uf120  \u001b[1;38;2;233;230;255mShell     \u001b[0m" },
    { "type": "terminal", "key": "\u001b7\u001b[61C\u001b[38;2;94;234;242m│\u001b8\u001b[38;2;94;234;242m│  \uf489  \u001b[1;38;2;233;230;255mTerminal  \u001b[0m" },
    { "type": "custom", "format": "\u001b[38;2;94;234;242m╰────────────────────────────────────────────────────────────╯\u001b[0m" },

    { "type": "custom", "format": "\u001b[38;2;255;77;109m\u001b7╭────────────────────────────────────────────────────────────╮\u001b8\u001b[21C ◆◆◆ \u001b[1m HARDWARE \u001b[22m ◆◆◆ \u001b[0m" },
    { "type": "custom", "format": "\u001b7\u001b[61C\u001b[38;2;255;77;109m│\u001b8\u001b[38;2;255;77;109m│  \uf109  \u001b[1;38;2;233;230;255mMachine   \u001b[0m MacBook Pro 13-inch · M1 · 2020" },
    { "type": "custom", "format": "\u001b7\u001b[61C\u001b[38;2;255;77;109m│\u001b8\u001b[38;2;255;77;109m│  \uf02a  \u001b[1;38;2;233;230;255mModel     \u001b[0m A2338 · EMC 3578" },
    { "type": "custom", "format": "\u001b7\u001b[61C\u001b[38;2;255;77;109m│\u001b8\u001b[38;2;255;77;109m│  \uf2db  \u001b[1;38;2;233;230;255mChip      \u001b[0m Apple M1 · 8-core CPU (4P + 4E)" },
    { "type": "custom", "format": "\u001b7\u001b[61C\u001b[38;2;255;77;109m│\u001b8\u001b[38;2;255;77;109m│  \uf26c  \u001b[1;38;2;233;230;255mGPU       \u001b[0m 8-core GPU · 16-core Neural Engine" },
    { "type": "custom", "format": "\u001b7\u001b[61C\u001b[38;2;255;77;109m│\u001b8\u001b[38;2;255;77;109m│  \uf0e4  \u001b[1;38;2;233;230;255mMemory    \u001b[0m 8 GB Unified Memory" },
    { "type": "custom", "format": "\u001b7\u001b[61C\u001b[38;2;255;77;109m│\u001b8\u001b[38;2;255;77;109m│  \uf0a0  \u001b[1;38;2;233;230;255mStorage   \u001b[0m 512 GB SSD" },
    { "type": "custom", "format": "\u001b7\u001b[61C\u001b[38;2;255;77;109m│\u001b8\u001b[38;2;255;77;109m│  \uf108  \u001b[1;38;2;233;230;255mDisplay   \u001b[0m 13.3\" Retina · 2560×1600 · 227ppi" },
    { "type": "custom", "format": "\u001b7\u001b[61C\u001b[38;2;255;77;109m│\u001b8\u001b[38;2;255;77;109m│  \uf0e7  \u001b[1;38;2;233;230;255mPower     \u001b[0m 58.2 Wh · USB-C 61W" },
    { "type": "custom", "format": "\u001b[38;2;255;77;109m╰────────────────────────────────────────────────────────────╯\u001b[0m" },

    { "type": "custom", "format": "\u001b[38;2;242;196;109m\u001b7╭────────────────────────────────────────────────────────────╮\u001b8\u001b[21C ◆◆◆ \u001b[1m  STATUS  \u001b[22m ◆◆◆ \u001b[0m" },
    { "type": "command", "key": "\u001b7\u001b[61C\u001b[38;2;242;196;109m│\u001b8\u001b[38;2;242;196;109m│  \uf0e4  \u001b[1;38;2;233;230;255mRAM       \u001b[0m", "text": "zsh __HOME__/.config/fastfetch/stat.sh ram" },
    { "type": "command", "key": "\u001b7\u001b[61C\u001b[38;2;242;196;109m│\u001b8\u001b[38;2;242;196;109m│  \uf0a0  \u001b[1;38;2;233;230;255mStorage   \u001b[0m", "text": "zsh __HOME__/.config/fastfetch/stat.sh disk" },
    { "type": "command", "key": "\u001b7\u001b[61C\u001b[38;2;242;196;109m│\u001b8\u001b[38;2;242;196;109m│               ", "text": "zsh __HOME__/.config/fastfetch/seg.sh bar" },
    { "type": "command", "key": "\u001b7\u001b[61C\u001b[38;2;242;196;109m│\u001b8\u001b[38;2;242;196;109m│               ", "text": "zsh __HOME__/.config/fastfetch/seg.sh legend" },
    { "type": "command", "key": "\u001b7\u001b[61C\u001b[38;2;242;196;109m│\u001b8\u001b[38;2;242;196;109m│  \uf240  \u001b[1;38;2;233;230;255mBattery   \u001b[0m", "text": "zsh __HOME__/.config/fastfetch/stat.sh batt" },
    { "type": "localip", "key": "\u001b7\u001b[61C\u001b[38;2;242;196;109m│\u001b8\u001b[38;2;242;196;109m│  \uf0ac  \u001b[1;38;2;233;230;255mIP        \u001b[0m", "showPrefixLen": false },
    { "type": "custom", "format": "\u001b[38;2;242;196;109m╰────────────────────────────────────────────────────────────╯\u001b[0m" },

    "break",
    { "type": "command", "key": " ", "text": "awk 'BEGIN{srand()} NF && length($0) <= 60 {a[++n]=$0} END{print a[int(rand()*n)+1]}' __HOME__/.config/fastfetch/quotes.txt",
      "format": "   \u001b[38;2;255;77;109m❯ \u001b[3;38;2;214;211;245m{1}\u001b[0m" }
  ]
}
